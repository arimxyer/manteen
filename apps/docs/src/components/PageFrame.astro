---
/* H17 — override of Starlight's PageFrame (upstream v0.41.5; keep in sync on upgrades).
   The default renders <MobileMenuToggle /> inside the sidebar <nav>, which forces the
   button to be a position:fixed overlay that can never participate in the header row's
   flex layout. SiteHeader.astro now renders the toggle as a real flex item, so this copy:
   1. drops the toggle from the nav;
   2. swaps the upstream `[aria-expanded='true'] ~ .sidebar-pane` sibling rule — which can
      no longer match — for one keyed off the `data-mobile-menu-expanded` attribute the
      toggle's script sets on <body>;
   3. drops the `[data-has-sidebar]` trailing header padding that reserved space for the
      fixed button, so the header computes one width on every page. */
const { hasSidebar } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const routePath = Astro.url.pathname.startsWith(base)
	? Astro.url.pathname.slice(base.length)
	: Astro.url.pathname;
// The landing page owns its product navigation. Keep Starlight's full docs header everywhere
// else, while the home route starts at the top edge exactly like the approved canvas.
const isLandingPage = routePath === "" || routePath === "/";
---

<div class="page sl-flex">
	{!isLandingPage && <header class="header"><slot name="header" /></header>}
	{
		hasSidebar && (
			<nav class="sidebar print:hidden" aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}>
				<div id="starlight__sidebar" class="sidebar-pane">
					<div class="sidebar-content sl-flex">
						<slot name="sidebar" />
					</div>
				</div>
			</nav>
		)
	}
	<div class="main-frame" data-home-landing={isLandingPage ? "true" : undefined}><slot /></div>
</div>

<style>
	@layer starlight.core {
		.page {
			flex-direction: column;
			min-height: 100vh;
		}

		.header {
			z-index: var(--sl-z-index-navbar);
			position: fixed;
			inset-inline-start: 0;
			inset-block-start: 0;
			width: 100%;
			height: var(--sl-nav-height);
			border-bottom: 1px solid var(--sl-color-hairline-shade);
			padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
			padding-inline-end: var(--sl-nav-pad-x);
			background-color: var(--sl-color-bg-nav);
		}

		.sidebar-pane {
			visibility: var(--sl-sidebar-visibility, hidden);
			position: fixed;
			z-index: var(--sl-z-index-menu);
			inset-block: var(--sl-nav-height) 0;
			inset-inline-start: 0;
			width: 100%;
			background-color: var(--sl-color-black);
			overflow-y: auto;
			scrollbar-gutter: stable;
		}

		:global(body[data-mobile-menu-expanded]) .sidebar-pane {
			--sl-sidebar-visibility: visible;
		}

		.sidebar-content {
			height: 100%;
			min-height: max-content;
			padding: 1rem var(--sl-sidebar-pad-x) 0;
			flex-direction: column;
			gap: 1rem;
		}

		/* M17 — the open drawer measured a 31px left gutter against 19px on the right. Half of
		   that was the since-removed registry rail's own asymmetric padding;
		   the other half is here. `scrollbar-gutter: stable` reserves the scrollbar's width on
		   the inline-end side only, which on a desktop rail sitting against a divider is
		   invisible and on a full-bleed drawer is a second unexplained offset. `both-edges`
		   reserves it symmetrically, so every row keeps one gutter on both sides. Scoped to the
		   drawer: at >=50rem the pane is a fixed-width column and the one-sided reservation is
		   what keeps its content from shifting when the list becomes scrollable. */
		@media (max-width: 49.999rem) {
			.sidebar-pane {
				scrollbar-gutter: stable both-edges;
			}
		}

		@media (min-width: 50rem) {
			.sidebar-content::after {
				content: '';
				padding-bottom: 1px;
			}

			.sidebar-pane {
				--sl-sidebar-visibility: visible;
				width: var(--sl-sidebar-width);
				background-color: var(--sl-color-bg-sidebar);
				border-inline-end: 1px solid var(--sl-color-hairline-shade);
			}
		}

		.main-frame {
			padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
			padding-inline-start: var(--sl-content-inline-start);
		}

		.main-frame[data-home-landing='true'] {
			padding-top: 0;
		}
	}
</style>
