---
import { Badge, Icon } from "@astrojs/starlight/components";

import { itemPath, readRegistry, registryGroups, type RegistryIndexItem } from "../lib/registry";
import {
  orderRegistryEntries,
  registryKindBadge,
  registryPresentationKind,
} from "../lib/registry-presentation";
import { RegistryCardPreview } from "./RegistryCardPreview";

interface Props {
  mode?: "full" | "embedded";
}

const { mode = "full" } = Astro.props;
const { entries } = readRegistry();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const detailHref = (name: string) => `${base}/registry/${itemPath(name)}/`;
const groups = registryGroups(entries).map((group) => ({
  ...group,
  items: orderRegistryEntries(group.items),
}));
const searchValue = (index: RegistryIndexItem) =>
  `${index.name} ${index.title ?? ""} ${index.description ?? ""} ${registryPresentationKind(index)}`.toLowerCase();
---

{
  /*
    The card body is ordinary Starlight vocabulary: an h3/h4 title link, `<Badge>` pills and a
    plain paragraph. The stretched `::after` on the title link (see custom.css) makes the whole
    card the navigation target without nesting anchors.
  */
}
{
  mode === "full" ? (
    <section data-registry-catalog>
      <p>
        Browse static examples and authored item documentation. Curated live previews appear when
        a registry publishes an adapter; one command brings the source into your project.
      </p>

      <div class="registry-search">
        <label>
          <Icon name="magnifier" />
          <span class="sr-only">Filter registry items</span>
          <input type="search" placeholder="Filter components, blocks, hooks, and themes…" data-registry-search />
        </label>
        <span aria-live="polite" data-registry-count>{entries.length} of {entries.length} shown</span>
      </div>

      {groups.map((group) => (
        <section data-registry-group>
          <h2 id={group.key}>{group.label}</h2>
          <div class="registry-grid">
            {group.items.map(({ index }) => (
              <article
                class="registry-card"
                data-registry-card
                data-registry-search-value={searchValue(index)}
              >
                <a class="registry-card__preview" href={detailHref(index.name)} tabindex="-1" aria-hidden="true">
                  <RegistryCardPreview name={index.name} />
                </a>
                <div class="registry-card__body">
                  <div class="registry-card__header">
                    <h3 class="registry-card__title">
                      <a href={detailHref(index.name)}>{index.title ?? index.name}</a>
                    </h3>
                    <p class="registry-card__badges">
                      <Badge
                        text={registryPresentationKind(index)}
                        size="small"
                        {...registryKindBadge(registryPresentationKind(index))}
                      />
                    </p>
                  </div>
                  {index.description && <p class="registry-card__description">{index.description}</p>}
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}

      <p hidden data-registry-empty>
        No registry items match this search.{" "}
        <button type="button" class="registry-reset" data-registry-reset>
          Show all items
        </button>
      </p>
    </section>
  ) : (
    <section class="registry-embed">
      <p class="registry-eyebrow">Live registry</p>
      <h2>Explore the registry</h2>
      <p>
        Browse static examples and authored item documentation from the live Manteen registry
        — {entries.length} published {entries.length === 1 ? "item" : "items"}, installable with
        one command.
      </p>
      <div class="registry-grid">
        {orderRegistryEntries(entries).map(({ index }) => (
          <article class="registry-card">
            <a class="registry-card__preview" href={detailHref(index.name)} tabindex="-1" aria-hidden="true">
              <RegistryCardPreview name={index.name} />
            </a>
            <div class="registry-card__body">
              <div class="registry-card__header">
                <h3 class="registry-card__title">
                  <a href={detailHref(index.name)}>{index.title ?? index.name}</a>
                </h3>
                <p class="registry-card__badges">
                  <Badge
                    text={registryPresentationKind(index)}
                    size="small"
                    {...registryKindBadge(registryPresentationKind(index))}
                  />
                </p>
              </div>
              {index.description && <p class="registry-card__description">{index.description}</p>}
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}

<script>
  for (const catalog of document.querySelectorAll<HTMLElement>("[data-registry-catalog]")) {
    const search = catalog.querySelector<HTMLInputElement>("[data-registry-search]");
    const cards = [...catalog.querySelectorAll<HTMLElement>("[data-registry-card]")];
    const groups = [...catalog.querySelectorAll<HTMLElement>("[data-registry-group]")];
    const count = catalog.querySelector<HTMLElement>("[data-registry-count]");
    const empty = catalog.querySelector<HTMLElement>("[data-registry-empty]");
    const total = cards.length;

    const update = () => {
      const query = search?.value.trim().toLowerCase() ?? "";
      let visible = 0;
      for (const card of cards) {
        card.hidden = Boolean(query) && !card.dataset.registrySearchValue?.includes(query);
        if (!card.hidden) visible += 1;
      }
      for (const group of groups) {
        group.hidden = !group.querySelector("[data-registry-card]:not([hidden])");
      }
      if (count) count.textContent = `${visible} of ${total} shown`;
      if (empty) empty.hidden = visible !== 0;
    };

    search?.addEventListener("input", update);
    catalog.querySelector<HTMLButtonElement>("[data-registry-reset]")?.addEventListener("click", () => {
      if (search) search.value = "";
      update();
      search?.focus();
    });
  }
</script>
