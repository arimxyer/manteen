---
import { Icon } from "@astrojs/starlight/components";

import { itemPath, kindLabel, readRegistry } from "../lib/registry";

const { entries } = readRegistry();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const detailHref = (name: string) => `${base}/registry/${itemPath(name)}/`;
const jsonHref = (name: string) => `${base}/r/${itemPath(name)}.json`;
---

<section class="registry-explorer" data-registry-catalog>
  <nav class="registry-explorer__breadcrumb" aria-label="Breadcrumb">
    <span>Registry</span>
    <span aria-hidden="true">/</span>
    <code>@house</code>
  </nav>

  <header class="registry-explorer__hero">
    <div>
      <p class="registry-eyebrow">Installable Mantine source</p>
      <h2>Explore the registry</h2>
      <p>
        Browse components, blocks, themes, and supporting files. Every item is installed as source
        your project owns.
      </p>
    </div>
    <div class="registry-explorer__count">
      <strong>{entries.length}</strong>
      <span>items available</span>
    </div>
  </header>

  <div class="registry-discovery">
    <label class="registry-search">
      <Icon name="magnifier" />
      <span class="sr-only">Search registry items</span>
      <input type="search" placeholder="Search components, blocks, themes…" data-registry-search />
    </label>
    <div class="registry-filters" role="group" aria-label="Filter registry items">
      <button type="button" class="is-active" aria-pressed="true" data-registry-filter="all">
        All
      </button>
      <button type="button" aria-pressed="false" data-registry-filter="component">
        Components
      </button>
      <button type="button" aria-pressed="false" data-registry-filter="block">Blocks</button>
      <button type="button" aria-pressed="false" data-registry-filter="library">Libraries</button>
      <button type="button" aria-pressed="false" data-registry-filter="file">Files</button>
    </div>
  </div>

  <div class="registry-catalog-heading">
    <h3>Available items</h3>
    <span aria-live="polite" data-registry-count>{entries.length} shown</span>
  </div>

  <div class="registry-grid">
    {
      entries.map(({ index, detail }) => {
        const type = kindLabel(index.type);
        const command = `npx manteen add @house/${index.name}`;
        const fileCount = detail.files?.length ?? 0;
        const dependencyCount = detail.dependencies?.length ?? 0;
        return (
          <article
            class="registry-card"
            data-registry-card
            data-registry-kind={type}
            data-registry-search={`${index.name} ${index.title ?? ""} ${index.description ?? ""} ${type}`.toLowerCase()}
          >
            <div class="registry-card__preview" aria-hidden="true">
              <span>{type}</span>
              <strong>{fileCount}</strong>
              <small>{fileCount === 1 ? "source file" : "source files"}</small>
            </div>
            <div class="registry-card__body">
              <header class="registry-card__header">
                <span class="registry-kind">{type}</span>
                {index.meta?.mantine?.requires && (
                  <small>Mantine {index.meta.mantine.requires}</small>
                )}
              </header>
              <h3>
                <a href={detailHref(index.name)}>{index.title ?? index.name}</a>
              </h3>
              <code class="registry-card__name">@house/{index.name}</code>
              {index.description && <p>{index.description}</p>}
              <div class="registry-card__facts">
                <span>{dependencyCount} npm {dependencyCount === 1 ? "dependency" : "dependencies"}</span>
                <span>{detail.registryDependencies?.length ?? 0} registry dependencies</span>
              </div>
              <div class="registry-card__command">
                <code>{command}</code>
                <button type="button" data-copy-value={command} data-copy-label="Copy">
                  Copy
                </button>
              </div>
              <footer>
                <a href={detailHref(index.name)}>View details</a>
                <a href={jsonHref(index.name)}>Raw JSON</a>
              </footer>
            </div>
          </article>
        );
      })
    }
  </div>

  <p class="registry-empty" hidden data-registry-empty>
    No registry items match this search and filter.
  </p>
</section>

<script>
  const writeClipboard = async (value: string) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(value);
      return;
    }
    const textarea = document.createElement("textarea");
    textarea.value = value;
    textarea.style.position = "fixed";
    textarea.style.opacity = "0";
    document.body.append(textarea);
    textarea.select();
    document.execCommand("copy");
    textarea.remove();
  };

  for (const catalog of document.querySelectorAll<HTMLElement>("[data-registry-catalog]")) {
    const search = catalog.querySelector<HTMLInputElement>("[data-registry-search]");
    const cards = [...catalog.querySelectorAll<HTMLElement>("[data-registry-card]")];
    const count = catalog.querySelector<HTMLElement>("[data-registry-count]");
    const empty = catalog.querySelector<HTMLElement>("[data-registry-empty]");
    let activeFilter = "all";

    const update = () => {
      const query = search?.value.trim().toLowerCase() ?? "";
      let visible = 0;
      for (const card of cards) {
        const matchesFilter = activeFilter === "all" || card.dataset.registryKind === activeFilter;
        const matchesSearch = !query || card.dataset.registrySearch?.includes(query);
        card.hidden = !(matchesFilter && matchesSearch);
        if (!card.hidden) visible += 1;
      }
      if (count) count.textContent = `${visible} shown`;
      if (empty) empty.hidden = visible !== 0;
    };

    search?.addEventListener("input", update);
    for (const button of catalog.querySelectorAll<HTMLButtonElement>("[data-registry-filter]")) {
      button.addEventListener("click", () => {
        activeFilter = button.dataset.registryFilter ?? "all";
        for (const option of catalog.querySelectorAll<HTMLButtonElement>("[data-registry-filter]")) {
          const selected = option === button;
          option.classList.toggle("is-active", selected);
          option.setAttribute("aria-pressed", String(selected));
        }
        update();
      });
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-value]")) {
    button.addEventListener("click", async () => {
      const idle = button.dataset.copyLabel ?? button.textContent ?? "Copy";
      try {
        await writeClipboard(button.dataset.copyValue ?? "");
        button.textContent = "Copied";
      } catch {
        button.textContent = "Copy failed";
      }
      window.setTimeout(() => {
        button.textContent = idle;
      }, 1600);
    });
  }
</script>
