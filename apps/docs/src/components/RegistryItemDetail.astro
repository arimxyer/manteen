---
import { Aside, Badge, Code, LinkButton, TabItem, Tabs } from "@astrojs/starlight/components";

import { ArticleCardPlayground } from "./ArticleCardPlayground";

import {
  acceptsProps,
  codeLanguage,
  fileKindLabel,
  fileName,
  isVisualItem,
  itemPath,
  kindLabel,
  packageStyleImports,
  styleFiles,
  type RegistryEntry,
} from "../lib/registry";
import {
  hasCuratedLivePreview,
  registryKindBadge,
  registryPresentationKind,
} from "../lib/registry-presentation";

interface Props {
  entry: RegistryEntry;
}

const { entry } = Astro.props;
const { index, detail: item } = entry;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const type = kindLabel(index.type);
const command = `npx manteen add @house/${index.name}`;
const rawJsonHref = `${base}/r/${itemPath(index.name)}.json`;
const sourceHref = item.files?.[0]
  ? `https://github.com/arimxyer/manteen/blob/main/${item.files[0].path}`
  : "https://github.com/arimxyer/manteen";
const mantine = item.meta?.mantine;
const files = item.files ?? [];
const installedStyles = styleFiles(item);
const packageStyles = packageStyleImports(item);
const stylesApi = mantine?.stylesApi;
const hasStylesApi = Boolean(stylesApi && Object.keys(stylesApi).length > 0);
const themeFragment = mantine?.themeFragment;
// Single source of truth, shared with the gallery badge in RegistryCatalog.astro.
const hasCuratedPreview = hasCuratedLivePreview(index.name);
const presentationKind = registryPresentationKind(index);
const presentationLabel =
  presentationKind === "theme"
    ? "Theme"
    : presentationKind === "file"
      ? "File"
      : presentationKind.charAt(0).toUpperCase() + presentationKind.slice(1);
const isProseFile = (file: (typeof files)[number]) => {
  const path = file.target ?? file.path;
  return /\.(?:txt|md)$/i.test(path) || /license/i.test(fileName(file));
};
// L5 — the requirement operator shipped glued to the number ("Mantine >=9"); the approved
// header reads "Mantine ≥ 9". Applied everywhere `mantine.requires` renders so the badge
// and the Requirements table never disagree on the same fact.
const formatRequirement = (value: string | undefined) => value?.replace(/^>=\s*/, "≥ ");
// L4 — a raw 40-char commit SHA in flowing prose produces a bad rag. Shortened to a git-style
// short hash inside a non-breaking mono span, with the full hash recoverable via `title`.
const SHA_PATTERN = /\b[0-9a-f]{40}\b/gi;
const renderAuthorNotes = (text: string) => {
  const parts: Array<string | { hash: string }> = [];
  let lastIndex = 0;
  for (const match of text.matchAll(SHA_PATTERN)) {
    const start = match.index ?? 0;
    if (start > lastIndex) parts.push(text.slice(lastIndex, start));
    parts.push({ hash: match[0] });
    lastIndex = start + match[0].length;
  }
  if (lastIndex < text.length) parts.push(text.slice(lastIndex));
  return parts;
};
// TextEncoder rather than Buffer so this stays runtime-agnostic.
const fileSize = (content: string | undefined) => {
  const bytes = new TextEncoder().encode(content ?? "").length;
  return bytes >= 1000 ? `${(bytes / 1000).toFixed(1)} kB` : `${bytes} B`;
};
const dependencyRows = [
  ...(item.dependencies ?? []).map((name) => ({ name, source: "npm", local: null as string | null })),
  ...(item.registryDependencies ?? []).map((name) => ({
    name,
    source: "registry",
    local: name.startsWith("@house/") ? name.slice(7) : null,
  })),
];
---

<p class="registry-item-meta">
  <Badge text={presentationLabel} size="small" {...registryKindBadge(presentationKind)} />
  {mantine?.requires && (
    <Badge text={`Mantine ${formatRequirement(mantine.requires)}`} variant="note" size="small" />
  )}
  <code>@house/{index.name}</code>
</p>

{index.description && <p>{index.description}</p>}

<p class="registry-item-links">
  <LinkButton href={rawJsonHref} variant="minimal" icon="document" iconPlacement="start">
    Registry JSON
  </LinkButton>
  <LinkButton href={sourceHref} variant="minimal" icon="github" iconPlacement="start">
    Source on GitHub
  </LinkButton>
</p>

<h2 id="install">Install</h2>
<p>One command copies the item's source into your project, where you own and edit it.</p>
<Code code={command} lang="sh" />

<h2 id="preview">Preview</h2>
{
  hasCuratedPreview ? (
    <ArticleCardPlayground client:load />
  ) : (
    <Aside
      type="note"
      title={isVisualItem(index.type) ? "Curated preview not published" : "Preview does not apply"}
    >
      <p>
        {
          isVisualItem(index.type)
            ? "The gallery image is a static example. This item does not publish a live preview adapter, and Manteen will not execute arbitrary registry source to manufacture one."
            : `A live component preview is not meaningful for a ${presentationLabel.toLowerCase()} item. Its installable payload is listed under Source.`
        }
      </p>
    </Aside>
  )
}

<h2 id="usage">Usage</h2>
<Aside type="note" title="No structured usage example">
  <p>
    Manteen does not infer JSX, imports, callback behavior, or sample data from source files. A
    copy-ready example will appear here only when the registry author publishes one.
  </p>
</Aside>

<h2 id="props">Props</h2>
{
  acceptsProps(index.type) ? (
    <Aside type="note" title="Structured props not published">
      <p>
        This item document does not carry prop names, types, defaults, or descriptions. The source
        is available, but this page does not present source inference as authored API
        documentation. You can <a href="#source">inspect the typed source</a> instead.
      </p>
    </Aside>
  ) : (
    <p>This {type} item does not expose a component or hook prop surface.</p>
  )
}

<h2 id="styling">Styling</h2>
{
  hasStylesApi ? (
    <Aside type="note" title="Declaration boundary">
      <p>
        These selectors are supplied by the registry author. Manteen reports the declaration but
        does not verify that the component wires every selector to <code>classNames</code>,{" "}
        <code>styles</code>, or a theme component entry.
      </p>
    </Aside>
  ) : (
    <Aside type="note" title="No public Styles API is declared">
      <p>
        Installed CSS remains editable because the project owns the source. Internal class names
        are implementation details, not a supported external customization contract.
      </p>
    </Aside>
  )
}

{
  stylesApi && Object.keys(stylesApi).length > 0 && (
    <>
      <h3 id="declared-selectors">Declared selectors</h3>
      <table>
        <thead>
          <tr>
            <th>Component</th>
            <th>Selectors</th>
          </tr>
        </thead>
        <tbody>
          {Object.entries(stylesApi).map(([component, selectors]) => (
            <tr>
              <td>
                <code>{component}</code>
              </td>
              <td>
                {selectors.map((selector, position) => (
                  <>
                    {position > 0 && " "}
                    <code>{selector}</code>
                  </>
                ))}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )
}

{
  installedStyles.length > 0 ? (
    <>
      <h3 id="installed-styles">Editable installed styles</h3>
      <p>These files are copied into the consuming project with the component source.</p>
      {installedStyles.map((file) =>
        file.content?.trim() ? (
          <Code
            code={file.content}
            lang={codeLanguage(file.target ?? file.path)}
            meta={`title="${fileName(file)}"`}
          />
        ) : (
          <p>{fileName(file)} is empty.</p>
        ),
      )}
    </>
  ) : (
    <p>This item does not ship a CSS, Sass, Less, or registry style file.</p>
  )
}

{
  packageStyles.length > 0 && (
    <>
      <h3 id="package-styles">Required package-level styles</h3>
      <p>Manteen composes these imports into the managed global stylesheet during install.</p>
      <ul>
        {packageStyles.map((source) => (
          <li>
            <code>{source}</code>
          </li>
        ))}
      </ul>
    </>
  )
}

{
  themeFragment?.content?.trim() && (
    <>
      <h3 id="theme-fragment">Theme fragment</h3>
      <p>Folded into the configured project theme; not written at this source path.</p>
      <Code
        code={themeFragment.content}
        lang={codeLanguage(themeFragment.path)}
        meta={`title="${themeFragment.path}"`}
      />
    </>
  )
}

<h2 id="source">Source</h2>
{
  files.length > 0 ? (
    <>
      <p>
        {files.length === 1
          ? "One installable file ships with this item."
          : `${files.length} installable files ship with this item.`}
      </p>
      {files.length > 1 ? (
        <Tabs>
          {files.map((file) => (
            <TabItem label={fileName(file)}>
              <p class="registry-file-facts">
                {fileKindLabel(file)} · {fileSize(file.content)} ·{" "}
                {isProseFile(file) ? "text" : codeLanguage(file.target ?? file.path)}
              </p>
              {file.content?.trim() ? (
                <Code
                  code={file.content}
                  lang={isProseFile(file) ? "txt" : codeLanguage(file.target ?? file.path)}
                  meta={`title="${file.path}"`}
                />
              ) : (
                <p>This file has no content.</p>
              )}
            </TabItem>
          ))}
        </Tabs>
      ) : (
        files.map((file) => (
          <>
            <p class="registry-file-facts">
              {fileKindLabel(file)} · {fileSize(file.content)} ·{" "}
              {isProseFile(file) ? "text" : codeLanguage(file.target ?? file.path)}
            </p>
            {file.content?.trim() ? (
              <Code
                code={file.content}
                lang={isProseFile(file) ? "txt" : codeLanguage(file.target ?? file.path)}
                meta={`title="${file.path}"`}
              />
            ) : (
              <p>This file has no content.</p>
            )}
          </>
        ))
      )}
    </>
  ) : (
    <Aside type="caution" title="No installable files">
      <p>The registry document does not contain a file payload.</p>
    </Aside>
  )
}

<h2 id="requirements">Requirements</h2>
<table>
  <tbody>
    <tr>
      <th scope="row">Mantine</th>
      <td>{formatRequirement(mantine?.requires) ?? "Not declared"}</td>
    </tr>
    <tr>
      <th scope="row">Provider</th>
      <td>{mantine?.provider ?? "Not declared"}</td>
    </tr>
    <tr>
      <th scope="row">Global styles</th>
      <td>{packageStyles.length || "None"}</td>
    </tr>
  </tbody>
</table>

<h2 id="dependencies">Dependencies</h2>
{
  dependencyRows.length > 0 ? (
    <table>
      <thead>
        <tr>
          <th>Package</th>
          <th>Source</th>
        </tr>
      </thead>
      <tbody>
        {dependencyRows.map((row) => (
          <tr>
            <td>
              {row.local ? (
                <a href={`${base}/registry/${itemPath(row.local)}/`}>
                  <code>{row.name}</code>
                </a>
              ) : (
                <code>{row.name}</code>
              )}
            </td>
            <td>{row.source}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <p>No npm or registry dependencies declared.</p>
  )
}

<h2 id="installed-files">Installed files</h2>
{
  files.length > 0 ? (
    <table>
      <thead>
        <tr>
          <th>File</th>
          <th>Kind</th>
          <th>Size</th>
        </tr>
      </thead>
      <tbody>
        {files.map((file) => (
          <tr>
            <td>
              <code>{fileName(file)}</code>
            </td>
            <td>{fileKindLabel(file)}</td>
            <td>{fileSize(file.content)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <p>No files.</p>
  )
}

{
  item.docs && (
    <>
      <h2 id="author-notes">Author notes</h2>
      <p>
        {renderAuthorNotes(item.docs).map((part) =>
          typeof part === "string" ? (
            part
          ) : (
            <code class="registry-note-hash" title={part.hash}>
              {part.hash.slice(0, 10)}&hellip;
            </code>
          ),
        )}
      </p>
    </>
  )
}

<script>
  // The previous design addressed its tab panels via `?tab=preview|usage|props|styling|source`.
  // Those panels are now plain sections with the same names as ids, so old deep links keep
  // landing on the right content.
  const requested = new URL(window.location.href).searchParams.get("tab");
  if (requested) {
    document.getElementById(requested)?.scrollIntoView();
  }
</script>
