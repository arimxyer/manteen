---
import DefaultHead from "@astrojs/starlight/components/Head.astro";
import mantineStylesHref from "@mantine/core/styles.layer.css?url";

// Core Mantine CSS loads on pages whose item ships a playground adapter — the same
// file-existence registry the detail page gates on. Package-specific extras (carousel,
// dropzone) are NOT linked here: each adapter imports its own, so they ride in that
// playground's lazy chunk instead of taxing every playground page.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const playgroundModules = import.meta.glob("./playgrounds/*.playground.tsx");
const playgroundItems = Object.keys(playgroundModules).flatMap((path) => {
  const match = path.match(/\/([^/]+)\.playground\.tsx$/);
  return match ? [match[1]] : [];
});
const hasPlayground = playgroundItems.some(
  (name) => Astro.url.pathname === `${base}/registry/${name}/`,
);
// SPIKE — the catalog card grid (registry index AND the home page's embedded catalog: see
// RegistryCatalog.astro's `mode` prop) now renders three items' real playground adapters as
// SSR-inert "live minis" (RegistryCardPreview.tsx), inside real MantineProvider instances. Both
// pages need core CSS unconditionally now, not just detail pages — this is a deliberate,
// page-weight-costing extension of the same gate, not a leak. Package-specific extras
// (carousel) still ride the mini's own import chain rather than being linked here, same as the
// detail-page convention above.
const isCatalogPage =
  Astro.url.pathname === `${base}/registry/` ||
  Astro.url.pathname === `${base}/registry` ||
  Astro.url.pathname === `${base}/` ||
  Astro.url.pathname === base;
// The home-page hero directions under review render a real Mantine component live (see
// components/home/StewardshipPanel.tsx), so their review routes need the same core CSS the
// catalog pages get. Prefix match, not an exact list, so adding a third direction doesn't
// silently ship an unstyled component.
const isHeroPreview = Astro.url.pathname.startsWith(`${base}/preview/`);
const needsCoreStyles = hasPlayground || isCatalogPage || isHeroPreview;
---

<DefaultHead />
{needsCoreStyles && <link rel="stylesheet" href={mantineStylesHref} />}
{
  /* Review-only, and deliberately temporary: direction C is typeset in Figtree + Fraunces, and
     this is the fastest way to judge the design. Before any of this ships the faces must be
     self-hosted (vendored .woff2 under src/assets/fonts, or @fontsource) — a docs site on GitHub
     Pages should not hand every reader's IP to a third party for a font, and a CDN round-trip is
     exactly the kind of detail this pass exists to get right. Flagged, not forgotten. */
  isHeroPreview && (
    <>
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;800&family=Fraunces:ital,opsz,wght@1,9..144,400..500&display=swap"
      />
    </>
  )
}
