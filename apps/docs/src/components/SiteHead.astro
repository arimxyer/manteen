---
import DefaultHead from "@astrojs/starlight/components/Head.astro";
import mantineStylesHref from "@mantine/core/styles.layer.css?url";

// Core Mantine CSS loads only on pages whose item ships a playground adapter — the same
// file-existence registry the detail page gates on. Package-specific extras (carousel,
// dropzone) are NOT linked here: each adapter imports its own, so they ride in that
// playground's lazy chunk instead of taxing every playground page.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const playgroundModules = import.meta.glob("./playgrounds/*.playground.tsx");
const playgroundItems = Object.keys(playgroundModules).flatMap((path) => {
  const match = path.match(/\/([^/]+)\.playground\.tsx$/);
  return match ? [match[1]] : [];
});
const hasPlayground = playgroundItems.some(
  (name) => Astro.url.pathname === `${base}/registry/${name}/`,
);
---

<DefaultHead />
{hasPlayground && <link rel="stylesheet" href={mantineStylesHref} />}
