---
import DefaultHead from "@astrojs/starlight/components/Head.astro";
import mantineStylesHref from "@mantine/core/styles.layer.css?url";

// Core Mantine CSS loads on pages whose item ships a playground adapter — the same
// file-existence registry the detail page gates on. Package-specific extras (carousel,
// dropzone) are NOT linked here: each adapter imports its own, so they ride in that
// playground's lazy chunk instead of taxing every playground page.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const playgroundModules = import.meta.glob("./playgrounds/*.playground.tsx");
const playgroundItems = Object.keys(playgroundModules).flatMap((path) => {
  const match = path.match(/\/([^/]+)\.playground\.tsx$/);
  return match ? [match[1]] : [];
});
const hasPlayground = playgroundItems.some(
  (name) => Astro.url.pathname === `${base}/registry/${name}/`,
);
// The registry catalog renders three items' real playground adapters as SSR-inert live minis
// inside MantineProvider instances. It therefore needs core CSS even though it is not a detail
// page. Package-specific extras still ride each mini's own import chain.
const isCatalogPage =
  Astro.url.pathname === `${base}/registry/` || Astro.url.pathname === `${base}/registry`;
const needsCoreStyles = hasPlayground || isCatalogPage;
---

<DefaultHead />
<!-- impeccable-live-start -->
<!-- <script is:inline src="http://localhost:8400/live.js?token=ae182ee2-6af4-47a1-933f-35fc648e0556"></script> -->
<!-- impeccable-live-end -->
{needsCoreStyles && <link rel="stylesheet" href={mantineStylesHref} />}
{/* Type is self-hosted — see styles/fonts.css, imported by the page that uses it. No font CDN,
    no third-party request, nothing to preconnect to. */}
