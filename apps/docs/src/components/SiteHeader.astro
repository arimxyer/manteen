---
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import MobileMenuToggle from "virtual:starlight/components/MobileMenuToggle";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";

const { hasSidebar } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pathname = Astro.url.pathname;
const routePath = pathname.startsWith(base) ? pathname.slice(base.length) : pathname;
const links = [
  {
    label: "Docs",
    // Registry authors is a branch of the same doc set (one shared sidebar), so it lights this
    // tab rather than carrying its own — a second tab into the same tree implied a separate
    // area that does not exist. Re-add a tab only if authors get their own document set.
    active: ["/getting-started/", "/concepts/", "/reference/", "/registry-authors/"].some(
      (prefix) => routePath.startsWith(prefix),
    ),
    href: `${base}/getting-started/`,
  },
  { label: "Registry", href: `${base}/registry/`, active: routePath.startsWith("/registry/") },
];
---

<div class="site-header">
  <div class="site-header__brand">
    <SiteTitle />
  </div>
  <nav class="site-header__nav" aria-label="Primary">
    {
      links.map((link) => (
        <a href={link.href} aria-current={link.active ? "page" : undefined}>{link.label}</a>
      ))
    }
  </nav>
  <div class="site-header__tools print:hidden">
    <Search />
    <div class="site-header__social">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
    <span class="site-header__menu">{hasSidebar && <MobileMenuToggle />}</span>
  </div>
</div>

<script>
  // H16 — the overflow regions were labeled for assistive tech but carried no visual signal
  // that content continued past the edge. `data-scroll-more-x` / `-y` drive the fade in
  // custom.css and are cleared as soon as that end is reached, so the affordance only ever
  // appears while there is genuinely more to see.
  const SCROLL_EPSILON = 2;

  const canScroll = (overflow: string) => overflow === "auto" || overflow === "scroll";

  const refreshScrollEdges = (scroller: HTMLElement) => {
    // `.manteen-table-scroll` only becomes a scroller below the grid breakpoint, and content can
    // overhang a visible-overflow box too — fading an edge the reader cannot scroll would be a
    // lie, so the axis has to be genuinely scrollable before the affordance is painted.
    const style = getComputedStyle(scroller);
    const moreX =
      canScroll(style.overflowX) &&
      scroller.scrollWidth - scroller.clientWidth - scroller.scrollLeft > SCROLL_EPSILON;
    const moreY =
      canScroll(style.overflowY) &&
      scroller.scrollHeight - scroller.clientHeight - scroller.scrollTop > SCROLL_EPSILON;
    scroller.toggleAttribute("data-scroll-more-x", moreX);
    scroller.toggleAttribute("data-scroll-more-y", moreY);
  };

  const trackScrollEdges = (scroller: HTMLElement) => {
    if (!scroller.dataset.scrollEdges) {
      scroller.dataset.scrollEdges = "on";
      scroller.addEventListener("scroll", () => refreshScrollEdges(scroller), { passive: true });
    }
    refreshScrollEdges(scroller);
  };

  const refreshAllScrollEdges = () => {
    const scrollers = document.querySelectorAll<HTMLElement>("[data-scroll-edges]");
    for (const scroller of scrollers) refreshScrollEdges(scroller);
  };

  const enhanceCodeRegions = () => {
    const regions = [...document.querySelectorAll<HTMLElement>("pre[data-language]")];
    for (const [index, region] of regions.entries()) {
      trackScrollEdges(region);
      region.setAttribute("role", "region");
      region.tabIndex = 0;
      if (region.hasAttribute("aria-label") || region.hasAttribute("aria-labelledby")) continue;
      const frameTitle = region.closest("figure")?.querySelector<HTMLElement>("figcaption, .title");
      const language = region.dataset.language;
      const subject = frameTitle?.textContent?.trim() || (language ? `${language} code` : "Code sample");
      region.setAttribute("aria-label", `${subject}, example ${index + 1}`);
    }
  };

  const enhanceTables = () => {
    const tables = [...document.querySelectorAll<HTMLTableElement>(".sl-markdown-content table")];
    for (const [index, table] of tables.entries()) {
      let frame = table.closest<HTMLElement>(".manteen-table-scroll");
      if (!frame) {
        frame = document.createElement("div");
        frame.className = "manteen-table-scroll";
        table.before(frame);
        frame.append(table);
      }
      const scrollable = frame.scrollWidth > frame.clientWidth;
      trackScrollEdges(frame);
      if (scrollable) {
        const pageTitle = document.querySelector("h1")?.textContent?.trim() || "Documentation";
        frame.tabIndex = 0;
        frame.setAttribute("role", "region");
        frame.setAttribute("aria-label", `${pageTitle} table ${index + 1}`);
      } else {
        frame.removeAttribute("tabindex");
        frame.removeAttribute("role");
        frame.removeAttribute("aria-label");
      }
    }
  };

  const enhanceDocument = () => {
    enhanceCodeRegions();
    enhanceTables();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => requestAnimationFrame(enhanceDocument), {
      once: true,
    });
  } else {
    requestAnimationFrame(enhanceDocument);
  }
  document.addEventListener("astro:page-load", () => requestAnimationFrame(enhanceDocument));
  // Starlight tab switches (the Source file tabs) reveal panes that were `display: none` and
  // therefore unmeasurable at enhancement time, so re-measure after the click lands.
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (!target.closest("starlight-tabs")) return;
    requestAnimationFrame(refreshAllScrollEdges);
  });

  window.addEventListener(
    "resize",
    () => {
      enhanceTables();
      refreshAllScrollEdges();
    },
    { passive: true },
  );

  // H17 — the menu toggle now lives in the header, outside the sidebar <nav>, so the
  // built-in escape-to-close listener (attached via `this.closest("nav")`) never binds.
  // Restore it at the document level: escape closes the open drawer from anywhere the
  // focus trap allows and returns focus to the toggle, matching upstream behavior.
  document.addEventListener("keyup", (event) => {
    if (event.code !== "Escape") return;
    if (!document.body.hasAttribute("data-mobile-menu-expanded")) return;
    const toggle = document.querySelector<HTMLElement & { setExpanded?: (expanded: boolean) => void }>(
      "starlight-menu-button",
    );
    toggle?.setExpanded?.(false);
    toggle?.querySelector("button")?.focus();
  });
</script>

<style>
  @layer starlight.core {
    .site-header {
      display: flex;
      height: 100%;
      align-items: center;
      gap: 2rem;
    }

    .site-header__brand {
      flex: none;
    }

    .site-header__nav {
      display: none;
      align-items: center;
      gap: 1.55rem;
    }

    .site-header__nav a {
      color: var(--sl-color-gray-2);
      font-size: var(--sl-text-base);
      font-weight: 600;
      text-decoration: none;
    }

    .site-header__nav a:hover {
      color: var(--sl-color-white);
    }

    /* L7 — the active-link state was declared as two adjacent blocks (colour, then the
       underline), so a later edit to "the" active-link rule would have touched only one of
       them. One state, one rule. */
    .site-header__nav a[aria-current="page"] {
      color: var(--sl-color-white);
      text-decoration: underline;
      text-decoration-color: var(--sl-color-accent);
      text-decoration-thickness: 2px;
      text-underline-offset: 0.45rem;
    }

    .site-header__tools,
    .site-header__social {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .site-header__tools {
      margin-inline-start: auto;
    }

    /* Desktop never shows the menu toggle (its button carries Starlight's
       `md:sl-hidden`); hide the wrapper too so the tools row gains no empty
       flex item + gap at >=50rem. */
    .site-header__menu {
      display: none;
    }

    .site-header__social::after {
      height: 1.5rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
      content: "";
    }

    :global(.site-header site-search button[data-open-modal]) {
      width: 2rem;
      height: 2rem;
      justify-content: center;
      padding: 0;
      border: 0;
      background: transparent;
      font-size: 1rem;
    }

    /* H2: these two children carry Starlight's `sl-hidden md:sl-block` / `md:sl-flex`
       utility classes, which live in the `starlight.utils` layer — declared *after*
       `starlight.core` (this block) in Starlight's own layer order. For a normal-weight
       declaration, a later layer always wins over an earlier one regardless of selector
       specificity, so an unqualified `display: none` here silently loses at >=50rem and
       the "Search"/"Ctrl K" content overflows the 2rem button onto the GitHub icon.
       `!important` sidesteps the layer order entirely: importance is resolved before
       layer/specificity in the cascade, so this beats Starlight's non-important utility
       classes unconditionally. */
    :global(.site-header site-search button[data-open-modal] > span),
    :global(.site-header site-search button[data-open-modal] > kbd) {
      display: none !important;
    }

    @media (min-width: 50rem) {
      .site-header__nav {
        display: flex;
      }
    }

    @media (max-width: 49.999rem) {
      :global(:root) {
        --sl-nav-height: 6.5rem;
      }

      .site-header {
        flex-wrap: wrap;
        align-content: center;
        gap: 0.55rem 0.8rem;
        padding-block: 0.45rem;
      }

      /* M20 — the row split into three equal centred columns, so "Docs" began at x≈61 while the
         logo, hero, eyebrow, headings and every card aligned to the x=16 gutter, and "Registry
         authors" stopped ~9px short of the right one. Natural-width, left-packed items align the
         first label to the same gutter as everything else; the negative inline margin lets each
         link keep the padding its active pill needs without pushing that first glyph inward.
         `flex: none` (not the previous `flex: 1`) is what keeps the columns off the stretch. */
      .site-header__nav {
        display: flex;
        order: 3;
        width: 100%;
        gap: 0.4rem;
        margin-inline-start: -0.45rem;
        overflow-x: auto;
      }

      .site-header__nav a {
        flex: none;
        min-width: max-content;
        padding: 0.4rem 0.45rem;
        border-radius: var(--manteen-radius-sm);
        font-size: var(--manteen-text-sm);
        text-align: left;
        white-space: nowrap;
      }

      .site-header__nav a[aria-current="page"] {
        background: var(--manteen-panel-active, var(--sl-color-gray-6));
        text-decoration: none;
      }

      .site-header__tools,
      .site-header__social {
        gap: 0.7rem;
      }

      .site-header__social::after {
        display: none;
      }

      /* H17: the menu toggle is now a real flex item in this row — the PageFrame.astro
         override stopped rendering it as a fixed overlay inside the sidebar nav.
         Restyle it from Starlight's filled floating circle to the same transparent
         32px icon treatment as the search/GitHub/theme controls beside it. The
         `.site-header__menu` wrapper renders (empty) on sidebar-less pages too, so
         the row keeps one geometry everywhere and controls no longer slide between
         `/` and doc pages. */
      .site-header__menu {
        display: flex;
        width: 2rem;
        height: 2rem;
        align-items: center;
        justify-content: center;
      }

      .site-header__menu :global(starlight-menu-button button) {
        position: static;
        width: 2rem;
        height: 2rem;
        background-color: transparent;
        box-shadow: none;
        color: var(--sl-color-gray-1);
      }

      .site-header__menu :global(starlight-menu-button[aria-expanded="true"] button) {
        background-color: var(--manteen-panel-active, var(--sl-color-gray-6));
        box-shadow: none;
      }
    }
  }
</style>
