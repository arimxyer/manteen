---
// Plain <img>, not astro:assets <Image> — see HeroLedger.astro for why (no Sharp in this workspace).
import manny from "../../assets/manny-canonical.png";
import { LiveMiniStyles, RegistryCardPreview } from "../RegistryCardPreview";
import { itemPath, kindLabel, readRegistry } from "../../lib/registry";
import styles from "./HeroIndex.module.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { entries } = readRegistry();

// The plate is four items chosen to show four different *shapes* of thing — a data display, a
// full block, a form, and a table — rather than four favourites. Anything missing from the
// registry is skipped rather than erroring, so this survives the catalog changing under it.
const PLATE = ["stat-card", "article-card", "authentication-form", "table-sort"];
const plate = PLATE.map((name) => entries.find((entry) => entry.index.name === name)).filter(
  (entry): entry is NonNullable<typeof entry> => Boolean(entry),
);
---

{/*
  Direction B — "The Index". Leads with the goods.

  No marketing hero at all: the page IS the catalogue, set the way a type foundry sets a specimen
  sheet. Where A argues, B just shows twenty-two things and how to install each one. The two
  differ on the axis that actually matters — what anchors the page — and share the type, colour,
  and label system in specimen.css. See docs/home-art-direction.md.
*/}

<section class={`spec ${styles.sheet}`} aria-labelledby="index-title">
  <LiveMiniStyles />

  <header class={styles.masthead}>
    <img
      class={`spec__manny ${styles.mannyMark}`}
      src={manny.src}
      alt=""
      width={manny.width}
      height={manny.height}
    />
    <p class={`spec__label ${styles.wordmark}`}>manteen</p>
    <p class="spec__label">{entries.length} specimens &middot; MIT &middot; Mantine v9</p>
  </header>

  {/* Cover entry: the headline is entry No. 00 of the same index, not a banner above it. That is
      what keeps the page reading as one object instead of a hero stapled to a list. */}
  <div class={styles.cover}>
    <div class={styles.coverHead}>
      <p class="spec__label spec__label--accent">No. 00</p>
      <p class="spec__label">The catalogue</p>
    </div>

    <div class={styles.coverBody}>
      <h1 class={`spec__display ${styles.coverTitle}`} id="index-title">
        Twenty-two Mantine specimens. Installed as source you own.
      </h1>

      <div class={styles.coverSide}>
        <p class="spec__lede">
          Every item below is real <code>.tsx</code> that lands in your repository, yours to edit
          — and <code>manteen update</code> still reconciles it with upstream afterwards.
        </p>
        <p class="spec__command">
          <span class="spec__commandPrompt" aria-hidden="true">$</span>
          <span class="spec__commandText">npx manteen add <b>@house/stat-card</b></span>
        </p>
        <div class="spec__actions">
          <a class="spec__cta" href={`${base}/getting-started/`}>
            Get started
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a class="spec__ctaGhost" href={`${base}/registry-authors/`}>Author a registry</a>
        </div>
      </div>
    </div>
  </div>

  {/* Plate: the only imagery on the page, and it is real components rather than art. */}
  <div class={styles.plate}>
    <div class="spec__sectionHead">
      <p class="spec__label spec__label--accent">Plate I</p>
      <p class="spec__label">Rendered live, from the registry</p>
    </div>
    <ul class={styles.plateGrid}>
      {
        plate.map((entry, i) => (
          <li class={styles.plateCell}>
            <div class={`spec__panel ${styles.plateFrame}`}>
              <RegistryCardPreview name={entry.index.name} />
            </div>
            <p class="spec__label">
              Fig. {String(i + 1).padStart(2, "0")} &nbsp; {entry.index.name}
            </p>
          </li>
        ))
      }
    </ul>
  </div>

  {/* The index proper. Thin ruled rows — number, name, kind, description, command. Density is the
      point: twenty-two lines of it reads as a real library, where six cards read as a sampler. */}
  <div class={styles.index}>
    <div class="spec__sectionHead">
      <p class="spec__label spec__label--accent">Index</p>
      <p class="spec__label">All {entries.length}</p>
    </div>
    <ol class={styles.rows}>
      {
        entries.map((entry, i) => (
          <li class={styles.row}>
            <a class={styles.rowLink} href={`${base}/registry/${itemPath(entry.index.name)}/`}>
              <span class={`spec__label ${styles.rowNum}`}>{String(i + 1).padStart(2, "0")}</span>
              <span class={styles.rowName}>{entry.index.title ?? entry.index.name}</span>
              <span class={`spec__label ${styles.rowKind}`}>{kindLabel(entry.index.type)}</span>
              <span class={styles.rowDesc}>{entry.index.description}</span>
              <span class={styles.rowCmd}>
                <span aria-hidden="true">manteen add </span>@house/{entry.index.name}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  {/* A list this long needs somewhere to land — without it the page just stops on row 22. */}
  <footer class={styles.colophon}>
    <p class={styles.colophonLine}>
      Author your own catalogue in Mantine's vocabulary; <code>manteen-kit</code> compiles it to
      the same shadcn-compatible JSON every client above reads.
    </p>
    <div class="spec__actions">
      <a class="spec__cta" href={`${base}/registry-authors/`}>
        Build a registry
        <span aria-hidden="true">&rarr;</span>
      </a>
      <a class="spec__ctaGhost" href="https://github.com/arimxyer/manteen">GitHub</a>
    </div>
  </footer>
</section>
