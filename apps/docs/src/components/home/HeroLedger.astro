---
// Plain <img>, not astro:assets <Image>: the image service needs Sharp, which this workspace does
// not install — `astro dev` transformed it happily and only `astro build` failed
// ("MissingSharp"). The asset is pre-sized to 303x320 for its 56-72px display box, so there is
// nothing for an optimizer to do here anyway.
import manny from "../../assets/manny-canonical.png";
import { readRegistry } from "../../lib/registry";
import StewardshipPanel from "./StewardshipPanel";
import styles from "./HeroLedger.module.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Counted, not typed: a hand-written "22" goes stale the next time the catalog grows, and nothing
// would fail when it did.
const { entries } = readRegistry();
---

{/*
  Direction A — "The Ledger". Leads with the argument.

  The anchor is deliberately NOT `command → file → component`: that is shadcn's hero and every
  registry can show it. This leads with the half only manteen has — source that landed, that you
  edited, that upstream also changed, and a tool that reconciles the two. See
  docs/home-art-direction.md.
*/}

<section class={`spec ${styles.hero}`} aria-labelledby="hero-title">
  <header class="spec__sectionHead">
    <p class="spec__label spec__label--accent">01 / manteen</p>
    <p class="spec__label">Mantine-native registry tooling</p>
  </header>

  <div class={styles.grid}>
    <div class={styles.lead}>
      <h1 class="spec__display" id="hero-title">Source you own, that still updates.</h1>

      <p class="spec__lede">
        <code>manteen add</code> writes real Mantine components into your repository — yours to
        read, edit, and keep. <code>manteen update</code> reconciles them with upstream later
        without taking them back.
      </p>

      <p class={`spec__command ${styles.command}`}>
        <span class="spec__commandPrompt" aria-hidden="true">$</span>
        <span class="spec__commandText">npx manteen add <b>@house/stat-card</b></span>
      </p>

      <div class={`spec__actions ${styles.actions}`}>
        <a class="spec__cta" href={`${base}/getting-started/`}>
          Install your first item
          <span aria-hidden="true">&rarr;</span>
        </a>
        {/* The two secondary routes stay together as one pair, so a narrow column drops them as a
            unit instead of stranding one on its own line under the button. */}
        <span class={styles.secondary}>
          <a class="spec__ctaGhost" href={`${base}/registry/`}>{entries.length} specimens</a>
          <a class="spec__ctaGhost" href={`${base}/registry-authors/`}>Author a registry</a>
        </span>
      </div>
    </div>

    <div class={styles.panelCol}>
      {/*
        `client:only` because the panel is a timer-driven React subtree with nothing useful to
        SSR — the same call PlaygroundHost.astro documents. The wrapper below reserves its box so
        the hero does not reflow when the island hydrates.
      */}
      <StewardshipPanel client:only="react" />
      <p class={`spec__label ${styles.figcap}`}>
        Fig. 01 — a live <code>StatCard</code>. <code>diff</code> is its real optional prop.
      </p>
    </div>
  </div>

  {/*
    Section 02 restates what `HomeOverview.astro` says today, in this system's voice. It exists
    because a crafted hero stacked on the untouched overview reads as two websites — the same
    defect class (three kicker treatments, three header alignments) that sank the earlier concepts.
    Propagating the type and rule system downward is the cheapest way to make the page one object.
  */}
  <section class={styles.tools} aria-labelledby="hero-tools-title">
    <header class="spec__sectionHead">
      <p class="spec__label spec__label--accent">02 / Toolkit</p>
      <p class="spec__label" id="hero-tools-title">Two packages, one contract</p>
    </header>

    <div class={styles.toolGrid}>
      <article class={styles.tool}>
        <p class="spec__label">Author</p>
        <h2 class={styles.toolName}>manteen-kit</h2>
        <p class={styles.toolSummary}>
          Write a catalog in Mantine's vocabulary. It compiles to the shadcn-compatible registry
          JSON other clients already read.
        </p>
        <p class="spec__command">
          <span class="spec__commandPrompt" aria-hidden="true">$</span>
          <span class="spec__commandText">npx manteen-kit <b>build</b></span>
        </p>
      </article>

      <article class={styles.tool}>
        <p class="spec__label">Consume</p>
        <h2 class={styles.toolName}>manteen</h2>
        <p class={styles.toolSummary}>
          Install registry source into a project and keep it: <code>init</code>, <code>add</code>,
          <code>list</code>, <code>info</code>, <code>diff</code>, <code>update</code>.
        </p>
        <p class="spec__command">
          <span class="spec__commandPrompt" aria-hidden="true">$</span>
          <span class="spec__commandText">npx manteen <b>diff</b> @house/stat-card</span>
        </p>
      </article>
    </div>
  </section>

  {/* Colophon: Manny at mark scale, once, with room around him — never a hero-sized character. */}
  <footer class={styles.colophon}>
    <img
      class={`spec__manny ${styles.mannyMark}`}
      src={manny.src}
      alt=""
      width={manny.width}
      height={manny.height}
    />
    <dl class={styles.facts}>
      <div>
        <dt class="spec__label">Base</dt>
        <dd>Mantine v9, an ordinary dependency</dd>
      </div>
      <div>
        <dt class="spec__label">Format</dt>
        <dd>shadcn-compatible registry JSON</dd>
      </div>
      <div>
        <dt class="spec__label">Receipt</dt>
        <dd><code>manteen.lock.json</code>, committed</dd>
      </div>
    </dl>
  </footer>
</section>
