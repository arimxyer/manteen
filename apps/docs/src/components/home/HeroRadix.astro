---
import { Code } from "@astrojs/starlight/components";

import manny from "../../assets/manny.png";
import { readRegistry } from "../../lib/registry";
import { HeroShowcase, HeroShowcaseStyles } from "./HeroShowcase";
import OwnershipPanel from "./OwnershipPanel";
import styles from "./HeroRadix.module.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { entries } = readRegistry();
const INSTALL = "npx manteen add @house/stat-card";

// The "how easy is this" proof, and it is the real thing: Mantine stays an ordinary import, the
// registry item is an ordinary local file. Nothing about consuming it is special, which is the
// claim worth making.
// Kept to two unindented lines on purpose: wrapped inside a function body it soft-wrapped in the
// hero's narrow column, and a code sample that wraps is the opposite of "look how little this
// takes".
const USAGE = `import { StatCard } from "@/components/ui/stat-card";

<StatCard label="Revenue" value="$48,200" diff={12.4} />`;
---

{/*
  Direction D. Ari's steer: C read as stiff, and the update/merge story felt like a features
  section rather than a hero. Radix was named as the target — it showcases how to use a component
  and how little ceremony it takes.

  So the hero now makes the ease argument (usage code, left) against evidence (real components at
  full size, right, bleeding off the edge), and the stewardship story moves below the fold where it
  has room to be a feature rather than a puzzle.
*/}

<div class={`mh ${styles.wrap}`}>
  <HeroShowcaseStyles />

  <section class={styles.hero} aria-labelledby="home-title">
    <div class={styles.copy}>
      <h1 class={`mh__display ${styles.title}`} id="home-title">
        Mantine components, <em>yours</em> to keep.
      </h1>

      <p class="mh__lede">
        The shadcn workflow, applied to Mantine. Install real source into your repository, edit it
        freely, and keep Mantine itself as an ordinary dependency — no fork, no wrapper, no
        configuration.
      </p>

      <div class={styles.usage}>
        <Code code={USAGE} lang="tsx" frame="none" showLineNumbers={false} />
      </div>

      <div class={styles.actions}>
        <a class="mh__cta" href={`${base}/getting-started/`}>
          Get started
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="mh__ghost" href={`${base}/registry/`}>Browse {entries.length} components</a>
      </div>

      <div class={styles.install}>
        <code class={styles.installText}
          ><span class={styles.prompt} aria-hidden="true">$</span>{INSTALL}</code
        >
        <button
          type="button"
          class={styles.copyBtn}
          data-copy={INSTALL}
          aria-label="Copy install command"
        >
          <span data-copy-idle>Copy</span>
          <span data-copy-done hidden>Copied</span>
        </button>
      </div>
    </div>

    <div class={styles.showcase}>
      <HeroShowcase />
      <p class={styles.showcaseNote}>Rendered live from the registry — not screenshots.</p>
    </div>
  </section>

  {/* The stewardship story, demoted out of the hero exactly as Ari read it: a feature, with room
      to be explained, rather than a puzzle the headline has to carry. */}
  <section class={styles.feature} aria-labelledby="feature-title">
    <div class={styles.featureCopy}>
      <h2 class={styles.featureTitle} id="feature-title">
        And it still updates.
      </h2>
      <p class="mh__lede">
        {/* The space before this <code> is explicit: Astro collapses the newline between a text
            node and an element here, and "and" ran straight into "manteen update". */}
        This is the part a copy-paste registry cannot do. The file above is yours — edit it however
        you like. When upstream changes, <code>manteen diff</code> shows you exactly what moved,
        and <code>manteen update</code> merges it without discarding your edits.
      </p>
    </div>
    <div class={styles.featurePanel}>
      <OwnershipPanel client:visible />
    </div>
  </section>

  <p class={styles.closing}>
    <img class={styles.manny} src={manny.src} alt="" width={manny.width} height={manny.height} />
    <span>
      {entries.length} components, blocks, hooks and themes — every one installable as source you
      own. <a class="mh__ghost" href={`${base}/registry/`}>See all {entries.length}</a>
    </span>
  </p>
</div>

<script>
  // Progressive enhancement: the command is selectable text with or without this running.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      const text = button.dataset.copy;
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const scratch = document.createElement("textarea");
        scratch.value = text;
        scratch.style.cssText = "position:fixed;opacity:0";
        document.body.append(scratch);
        scratch.select();
        document.execCommand("copy");
        scratch.remove();
      }
      const idle = button.querySelector<HTMLElement>("[data-copy-idle]");
      const done = button.querySelector<HTMLElement>("[data-copy-done]");
      if (!idle || !done) return;
      idle.hidden = true;
      done.hidden = false;
      button.dataset.copied = "true";
      window.setTimeout(() => {
        idle.hidden = false;
        done.hidden = true;
        delete button.dataset.copied;
      }, 1600);
    });
  }
</script>
