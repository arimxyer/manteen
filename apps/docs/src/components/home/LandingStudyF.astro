---
import {
  IconArrowRight,
  IconArrowUpRight,
  IconBook2,
  IconCheck,
  IconChevronRight,
  IconCopy,
  IconShieldExclamation,
} from "@tabler/icons-react";
import { Image } from "astro:assets";

import mannyBringHome from "../../assets/manny/manny-bringing-source-home.png";
import mannyCompare from "../../assets/manny/manny-comparing-diffs.png";
import mannyEdit from "../../assets/manny/manny-editing-owned-source.png";
import mannyGuardrail from "../../assets/manny/manny-guardrail.png";
import mannyMantine from "../../assets/manny/manny-mantine-ambassador.png";
import mannyReyamira from "../../assets/manny/manny-reyamira-connection.png";
import mannySuccess from "../../assets/manny/manny-success.png";
import mannyWelcome from "../../assets/manny/manny-welcome.png";
import mannyWorking from "../../assets/manny/manny-working.png";
import styles from "./LandingStudyF.module.css";
import "../../styles/fonts.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = {
  docs: `${base}/getting-started/`,
  registry: `${base}/registry/`,
  agent: `${base}/getting-started/agent-guide/`,
  authors: `${base}/registry-authors/`,
  github: "https://github.com/arimxyer/manteen",
};

const sourceStates = [
  {
    number: "01",
    label: "Installed",
    title: "Real source lands\nin your repo.",
    code: ["components/ui/", "article-card.tsx"],
    note: "Editable by design.",
    tone: "installed",
  },
  {
    number: "02",
    label: "You edited",
    title: "The component\nbecomes yours.",
    code: ['~ radius="lg"', "  // your adaptation"],
    note: "Expected, not exceptional.",
    tone: "local",
  },
  {
    number: "03",
    label: "Upstream moved",
    title: "New source is\navailable.",
    code: ["+ rating?: number", "  // registry update"],
    note: "Provenance remains visible.",
    tone: "upstream",
  },
];

const ownershipSteps = [
  ["01", "Install", "Bring source into your project.", "purple"],
  ["02", "Edit", "Change it as ordinary project code.", "white"],
  ["03", "Upstream", "Review what changed in the registry.", "amber"],
  ["04", "Reconcile", "Choose the result before Manteen writes.", "green"],
] as const;

const editLines = [
  ["18", "  title,", "plain"],
  ["19", "+ eyebrow = 'Field note',", "add"],
  ["20", "+ density = 'compact',", "add"],
  ["21", "  image,", "plain"],
  ["22", "}: ArticleCardProps) {", "plain"],
  ["23", "  return (", "plain"],
  ["24", "    <article className={cx(classes.root,", "plain"],
  ["25", "+     classes[density])}>", "add"],
  ["26", '+     <Text c="dimmed">{eyebrow}</Text>', "add"],
  ["27", "      <Title order={3}>{title}</Title>", "plain"],
] as const;

const mergeStates = [
  ["Base", "Pristine ancestor", "title + image", "purple"],
  ["Local", "Your adaptation", "+ eyebrow\n+ compact density", "amber"],
  ["Incoming", "Registry update", "+ accessible heading\n+ image fallback", "amber"],
  ["Result", "Proposed source", "local intent + upstream fixes", "green"],
] as const;

const toolRoles = [
  {
    name: "Manteen",
    role: "Consumer source",
    copy: "Discover, inspect, install, adapt, diff, update, and remove source inside a real project.",
    actions: ["list", "info", "add", "diff", "update"],
    tone: "consumer",
  },
  {
    name: "Manteen Kit",
    role: "Registry kit",
    copy: "Author, validate, compile, preview, and publish a registry with deterministic output ownership.",
    actions: ["build", "check", "json", "publish"],
    tone: "registry",
  },
];

const agentFeatures = [
  ["Inspect", "status --json", "One stable machine envelope."],
  ["Preview", "--dry-run --json", "A mutation becomes a reviewable plan."],
  ["Verify", "planDigest → expect-plan", "The applied inputs must match the inspected plan."],
] as const;

const command = "npx manteen add @house/article-card --dry-run --json";
---

<div class={styles.root} data-landing-study="f">
  <section class={styles.hero} aria-labelledby="landing-title">
    <nav class={styles.nav} aria-label="Primary">
      <a class={styles.brand} href={`${base}/`} aria-label="Manteen home">
        <Image src={mannyMantine} alt="" width={40} height={40} loading="eager" />
        <span>manteen</span>
      </a>
      <div class={styles.navLinks}>
        <a href={links.docs}>Docs</a>
        <a href={links.registry}>Registry</a>
        <a href={links.agent}>Agent guide</a>
        <span class={styles.version}>v0.8.0</span>
      </div>
    </nav>

    <div class={styles.heroBody}>
      <div class={styles.category}><span></span>A source-owned component registry for Mantine</div>
      <div class={styles.heroIntro}>
        <div class={styles.heroHeadline}>
          <p class={styles.eyebrow}><strong>01</strong> The source trail</p>
          <h1 id="landing-title">
            Source you own,<br />
            <em>that still knows</em><br />
            where it came from.
          </h1>
        </div>
        <div class={styles.heroSupport}>
          <p>
            Install Mantine source into your project. Change it there. When registry source moves,
            inspect and reconcile before writing.
          </p>
          <div class={styles.heroActions}>
            <a class={styles.primaryAction} href={links.docs}><span aria-hidden="true">$</span> Get started</a>
            <a class={styles.textAction} href="#ownership-loop">See the workflow <IconArrowRight size={16} aria-hidden="true" /></a>
          </div>
        </div>
      </div>

      <div class={styles.trail} role="group" aria-label="Source ownership trail">
        <div class={styles.trailHeader}>
          <span>One continuous ownership record</span>
          <span class={styles.trailSequence}>Source <IconArrowRight size={12} aria-hidden="true" /> Local <IconArrowRight size={12} aria-hidden="true" /> Upstream <IconArrowRight size={12} aria-hidden="true" /> Reconciled</span>
        </div>
        <div class={styles.sourceGrid}>
          {sourceStates.map((state) => (
            <article class={`${styles.sourceCard} ${styles[state.tone]}`}>
              <p class={styles.cardLabel}><span>{state.number}</span>{state.label}</p>
              <h2>{state.title.split("\n").map((line) => <>{line}<br /></>)}</h2>
              <div class={styles.miniCode}>{state.code.map((line) => <code>{line}</code>)}</div>
              <p class={styles.cardNote}>{state.note}</p>
            </article>
          ))}
          <article class={`${styles.sourceCard} ${styles.reconciled}`}>
            <div>
              <p class={styles.cardLabel}><span>04</span>Reconciled</p>
              <h2>Both changes.<br />One maintained source.</h2>
              <p>Review the plan, apply the same inputs, keep ownership.</p>
              <code><IconCheck size={14} aria-hidden="true" /> clean diff&nbsp; · &nbsp;healthy receipt</code>
            </div>
            <Image src={mannyWelcome} alt="" width={250} height={250} loading="eager" />
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class={styles.ownership} id="ownership-loop" aria-labelledby="ownership-title">
    <div class={styles.railSet} aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div class={styles.ownershipHeader}>
      <div>
        <p class={styles.sectionEyebrow}>The ownership loop</p>
        <h2 id="ownership-title">Install, change, and update source you own.</h2>
      </div>
      <Image src={mannyWorking} alt="" width={250} height={250} />
      <p>
        Manteen gives you source you can change while preserving enough history to understand what
        changed upstream and what changed locally.
      </p>
    </div>
    <ol class={styles.ownershipSteps}>
      {ownershipSteps.map(([number, name, copy, tone]) => (
        <li class={styles[tone]}>
          <span>{number}</span>
          <h3>{name}</h3>
          <p>{copy}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class={`${styles.storyBand} ${styles.installBand}`} aria-labelledby="install-title">
    <div class={styles.installNarrative}>
      <Image class={styles.installManny} src={mannyBringHome} alt="" width={400} height={267} />
      <p class={styles.sectionMarker}><span></span>01 / Install</p>
      <h2 id="install-title">Install source into your project.</h2>
      <p>
        Manteen writes the component into your project as ordinary source and records the registry
        identity and pristine base needed to understand it later.
      </p>
      <aside class={styles.installNote}>
        <strong>Installed ≠ in use</strong>
        <span>The files are in your project. You still import and compose the component where your product needs it.</span>
      </aside>
      <div class={styles.guidance}>
        <strong>Files added</strong>
        <span>Import and compose them where the product uses the component.</span>
      </div>
    </div>

    <div class={styles.terminal}>
      <header>
        <span class={styles.windowDots} aria-hidden="true"><i></i><i></i><i></i></span>
        <span>registry / @house</span>
      </header>
      <div class={styles.terminalBody}>
        <div class={styles.commandRow}>
          <code tabindex="0">$ {command}</code>
          <button type="button" data-copy-command={command} aria-label="Copy install command">
            <IconCopy size={16} aria-hidden="true" />
            <span data-copy-label>Copy</span>
          </button>
        </div>
        <div class={styles.planGrid}>
          <div class={styles.plannedFiles}>
            <strong>Planned files</strong>
            {[
              "article-card.tsx",
              "article-card.module.css",
              "manteen.lock.json",
              ".manteen/bases/…",
            ].map((file) => <code><span aria-hidden="true">+</span>{file}</code>)}
          </div>
          <div class={styles.planReceipt}>
            <strong>Plan ready</strong>
            <code>planDigest<br />4b7e…a921</code>
            <span>No files written</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class={`${styles.storyBand} ${styles.editBand}`} aria-labelledby="edit-title">
    <div class={styles.codeArtifact}>
      <header>
        <code>src/components/article-card/article-card.tsx</code>
        <span>adapted locally</span>
      </header>
      <div
        class={styles.codeLines}
        role="region"
        aria-label="Locally adapted source diff; scroll horizontally to read long lines"
        tabindex="0"
      >
        {editLines.map(([number, line, tone]) => (
          <div class={styles[tone]}><span>{number}</span><code>{line}</code></div>
        ))}
      </div>
      <footer>
        {[
          ["baseSha256", "9af2…4c10"],
          ["installedSha256", "d021…991a"],
          ["registry item", "@house/article-card"],
        ].map(([label, value]) => <div><span>{label}</span><code>{value}</code></div>)}
      </footer>
    </div>
    <div class={styles.editNarrative}>
      <p class={styles.sectionMarker}><span></span>02 / Edit</p>
      <h2 id="edit-title">Edit it as ordinary project code.</h2>
      <p>Local changes stay in your project. The receipt keeps them distinguishable from future registry updates.</p>
    </div>
    <div class={styles.editGuide}>
      <strong>Local source</strong>
      <span>Change the file in place. The receipt remains separate from the code you edit.</span>
    </div>
    <Image class={styles.editManny} src={mannyEdit} alt="" width={400} height={333} />
  </section>

  <section class={styles.reconcileBand} aria-labelledby="reconcile-title">
    <div class={styles.reconcileHeader}>
      <div>
        <p class={styles.sectionMarker}><span></span>03 + 04 / Upstream → Reconcile</p>
        <h2 id="reconcile-title">Compare local and registry changes before writing.</h2>
      </div>
      <p>
        Manteen keeps the pristine base, your accepted source, and the incoming registry version
        separate, then previews the proposed result.
      </p>
    </div>
    <div class={styles.mergeTrail}>
      {mergeStates.map(([label, title, change, tone], index) => (
        <>
          <article class={styles[tone]}>
            <p>{label}</p>
            <h3>{title}</h3>
            <code>{change.split("\n").map((line) => <>{line}<br /></>)}</code>
          </article>
          {index < mergeStates.length - 1 && <IconChevronRight className={styles.mergeArrow} size={24} aria-hidden="true" />}
        </>
      ))}
    </div>
    <div class={styles.transaction}>
      <div><strong>Verified transaction</strong><code>manteen update @house/article-card --expect-plan 4b7e…a921</code></div>
      <div><strong>Applied · 3 files</strong><code>receipt v3 · base refreshed</code></div>
    </div>
    <p class={styles.destructiveNote}><IconShieldExclamation size={19} aria-hidden="true" />Replacement stays an explicit decision. A destructive flag is never treated as an automatic retry.</p>
    <div class={styles.reconcileGuide}><strong>Plan verified</strong><span>The proposed result keeps local intent and registry changes visible.</span></div>
    <Image class={styles.reconcileManny} src={mannyCompare} alt="" width={400} height={317} />
  </section>

  <section class={styles.ecosystem} aria-labelledby="ecosystem-title">
    <div class={`${styles.railSet} ${styles.ecosystemRails}`} aria-hidden="true"><i></i><i></i></div>
    <div class={styles.ecosystemHeader}>
      <div><p class={styles.sectionEyebrow}>The Manteen ecosystem</p><h2 id="ecosystem-title">Manteen installs source. Manteen Kit publishes registries.</h2></div>
      <Image src={mannyGuardrail} alt="" width={250} height={250} />
      <p>Use Manteen in consumer projects. Use Manteen Kit to author, validate, and publish deterministic registry output.</p>
    </div>
    <div class={styles.toolRoles}>
      {toolRoles.map((tool) => (
        <article class={styles[tool.tone]}>
          <header><h3>{tool.name}</h3><span>{tool.role}</span></header>
          <p>{tool.copy}</p>
          <div>{tool.actions.map((action) => <code>{action}</code>)}</div>
        </article>
      ))}
    </div>
    <div class={styles.agentContract}>
      <header><h3>Designed to be inspected before it writes.</h3><span>Agent-safe throughout</span></header>
      <div>
        {agentFeatures.map(([label, commandText, copy]) => (
          <article><strong>{label}</strong><code>{commandText}</code><p>{copy}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class={styles.closing} aria-labelledby="closing-title">
    <div class={styles.closingCta}>
      <div>
        <p class={styles.sectionEyebrow}>Source stewardship, end to end</p>
        <h2 id="closing-title">Start with the registry, then follow the source.</h2>
        <p>Inspect the component, preview the plan, and reconcile source changes before Manteen writes.</p>
      </div>
      <Image src={mannySuccess} alt="" width={245} height={245} />
      <div class={styles.closingActions}>
        <a href={links.registry}>Explore the registry <IconArrowUpRight size={17} aria-hidden="true" /></a>
        <a href={links.agent}>Read the agent guide <IconBook2 size={17} aria-hidden="true" /></a>
      </div>
    </div>
    <div class={styles.closingTrail} role="group" aria-label="Registry to reconciliation">
      {[
        ["Registry", "purple"],
        ["Project", "white"],
        ["Adaptation", "amber"],
        ["Reconciliation", "green"],
      ].map(([label, tone], index) => (
        <><span class={styles[tone]}>{label}</span>{index < 3 && <IconArrowRight size={15} aria-hidden="true" />}</>
      ))}
    </div>
    <footer class={styles.footer}>
      <div class={styles.footerBrand}>
        <Image src={mannyReyamira} alt="" width={200} height={133} />
        <div><strong>manteen</strong><span>Source-owned. Mantine-native. Agent-safe.</span></div>
      </div>
      <nav aria-label="Footer">
        <a href={links.docs}>Docs</a><a href={links.registry}>Registry</a><a href={links.agent}>Agent guide</a><a href={links.authors}>Manteen Kit</a><a href={links.github}>GitHub</a>
      </nav>
    </footer>
    <p class={styles.disclaimer}>A Reyamira project. Manteen is independent and is not affiliated with or endorsed by the Mantine team.</p>
  </section>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-command]")) {
    button.addEventListener("click", async () => {
      const command = button.dataset.copyCommand;
      if (!command) return;
      const label = button.querySelector<HTMLElement>("[data-copy-label]");
      if (!label) return;
      try {
        await navigator.clipboard.writeText(command);
      } catch {
        label.textContent = "Copy unavailable";
        window.setTimeout(() => {
          label.textContent = "Copy";
        }, 1800);
        return;
      }
      label.textContent = "Copied";
      button.dataset.copied = "true";
      window.setTimeout(() => {
        label.textContent = "Copy";
        delete button.dataset.copied;
      }, 1500);
    });
  }
</script>

<style is:global>
  body:has([data-landing-study="f"]) .content-panel:first-of-type {
    display: none;
  }

  body:has([data-landing-study="f"]) .content-panel,
  body:has([data-landing-study="f"]) .main-pane {
    padding: 0;
  }

  body:has([data-landing-study="f"]) .content-panel .sl-container {
    max-width: none;
  }

  body:has([data-landing-study="f"]) .main-frame,
  body:has([data-landing-study="f"]) .main-pane {
    overflow-x: clip;
  }

  body:has([data-landing-study="f"]) main {
    padding-bottom: 0;
  }

  body:has([data-landing-study="f"]) .content-panel > .sl-container > footer.sl-flex {
    display: none;
  }
</style>
