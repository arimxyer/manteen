---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import HeroIndex from "../../components/home/HeroIndex.astro";
import "../../styles/specimen.css";

// Review-only route. See hero-a.astro for why both directions render inside the real site chrome.
---

<StarlightPage
  frontmatter={{
    title: "Hero B — The Index",
    description: "Home page direction B: the catalogue itself, set as a specimen sheet.",
    template: "splash",
    editUrl: false,
    lastUpdated: false,
    next: false,
    prev: false,
    pagefind: false,
  }}
  hasSidebar={false}
>
  <HeroIndex />
</StarlightPage>

<style is:global>
  /* Review-page chrome only — same rationale as hero-a.astro. */
  .content-panel:first-of-type {
    display: none;
  }

  .content-panel .sl-container {
    max-width: 76rem;
  }
</style>
