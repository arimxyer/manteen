---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import HeroHome from "../../components/home/HeroHome.astro";
import "../../styles/home-v3.css";

// Review-only route. Renders inside the real site chrome so type, tokens and the theme toggle
// behave exactly as they would on the home page.
---

<StarlightPage
  frontmatter={{
    title: "Hero C",
    description: "Home page direction C: austere, typeset, one live artifact.",
    template: "splash",
    editUrl: false,
    lastUpdated: false,
    next: false,
    prev: false,
    pagefind: false,
  }}
  hasSidebar={false}
>
  <HeroHome />
</StarlightPage>

<style is:global>
  /* Review-page chrome only. StarlightPage always renders its frontmatter title; the real home
     page would not have one (replacing `hero:` means there is no title block at all). */
  .content-panel:first-of-type {
    display: none;
  }

  .content-panel .sl-container {
    max-width: none;
  }

  /* The hero owns the full page ground in this direction, not just a band inside Starlight's
     content column. */
  .content-panel {
    padding-inline: 0;
  }
</style>
