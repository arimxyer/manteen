---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import HeroRadix from "../../components/home/HeroRadix.astro";
import "../../styles/fonts.css";
import "../../styles/home-v3.css";

// Review-only route.
---

<StarlightPage
  frontmatter={{
    title: "Hero D",
    description: "Home page direction D: usage code as the argument, real components as evidence.",
    template: "splash",
    editUrl: false,
    lastUpdated: false,
    next: false,
    prev: false,
    pagefind: false,
  }}
  hasSidebar={false}
>
  <HeroRadix />
</StarlightPage>

<style is:global>
  /* Review-page chrome only — the real home page has no frontmatter title block. */
  .content-panel:first-of-type {
    display: none;
  }

  /* These two must travel with the component when it ships, not stay behind on the preview route.
     The real home page's `.sl-container` computes to max-width: 1080px with 24px of panel padding,
     which leaves the hero a 1032px measure — and HeroRadix's two-column breakpoint keys on VIEWPORT
     width while the real constraint is CONTAINER width. Above a 1280px viewport the two-column
     layout would engage inside a 1080px container, putting the copy track at ~445px, under the
     519px the usage sample needs to stay on two lines. Either carry these overrides across, or
     convert the breakpoint to a container query. */
  .content-panel .sl-container {
    max-width: none;
  }

  .content-panel {
    padding-inline: 0;
  }

  /* The showcase column is meant to run off the right edge; Starlight's wrappers must not clip it
     early or grow a scrollbar around it. `.wrap` owns the clip. */
  .main-pane,
  .main-frame {
    overflow-x: clip;
  }
</style>
