---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import LandingStudyF from "../../components/home/LandingStudyF.astro";

// Review-only route.
---

<StarlightPage
  frontmatter={{
    title: "Landing Study F",
    description: "Study F: source stewardship explained from installation through reconciliation.",
    template: "splash",
    editUrl: false,
    lastUpdated: false,
    next: false,
    prev: false,
    pagefind: false,
  }}
  hasSidebar={false}
>
  <LandingStudyF />
</StarlightPage>

<style is:global>
  /* Review-page chrome only — the real home page has no frontmatter title block. */
  .content-panel:first-of-type {
    display: none;
  }

  /* The landing component is full-width on both the review route and the real home page. */
  .content-panel .sl-container {
    max-width: none;
  }

  .content-panel {
    padding-inline: 0;
  }

  .main-pane,
  .main-frame {
    overflow-x: clip;
  }
</style>
