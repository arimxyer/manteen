---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import RegistryItemDetail from "../../components/RegistryItemDetail.astro";
import { readRegistry, registrySidebar, type RegistryEntry } from "../../lib/registry";

interface Props {
  entry: RegistryEntry;
}

export function getStaticPaths() {
  const { entries } = readRegistry();
  return entries.map((entry) => ({
    params: { item: entry.index.name },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { entries } = readRegistry();

// Section ids must match the h2 ids RegistryItemDetail.astro renders — the TOC scrolls by slug.
const headings = [
  { depth: 2, slug: "install", text: "Install" },
  { depth: 2, slug: "preview", text: "Preview" },
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 2, slug: "props", text: "Props" },
  { depth: 2, slug: "styling", text: "Styling" },
  { depth: 2, slug: "source", text: "Source" },
  { depth: 2, slug: "requirements", text: "Requirements" },
  { depth: 2, slug: "dependencies", text: "Dependencies" },
  { depth: 2, slug: "installed-files", text: "Installed files" },
  ...(entry.detail.docs ? [{ depth: 2, slug: "author-notes", text: "Author notes" }] : []),
];
---

<StarlightPage
  frontmatter={{
    title: entry.index.title ?? entry.index.name,
    description: entry.index.description,
    editUrl: false,
    lastUpdated: false,
    next: false,
    prev: false,
  }}
  sidebar={registrySidebar(entries)}
  hasSidebar={true}
  headings={headings}
>
  <RegistryItemDetail entry={entry} />
</StarlightPage>
