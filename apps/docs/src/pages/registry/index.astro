---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import RegistryCatalog from "../../components/RegistryCatalog.astro";
import { readRegistry, registryGroups, registrySidebar } from "../../lib/registry";

const { entries } = readRegistry();
const headings = registryGroups(entries).map((group) => ({
  depth: 2,
  slug: group.key,
  text: group.label,
}));
---

<StarlightPage
  frontmatter={{
    title: "Registry",
    description: "Browse installable Mantine-native source from the live Manteen registry.",
    editUrl: false,
    lastUpdated: false,
    next: false,
    prev: false,
  }}
  sidebar={registrySidebar(entries)}
  hasSidebar={true}
  headings={headings}
>
  <RegistryCatalog mode="full" />
</StarlightPage>
