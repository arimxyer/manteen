{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://manteen.dev/schema/manteen.lock.schema.json",
  "title": "manteen install receipt",
  "description": "What manteen accepted, its pristine upstream merge base, where it lives, and on whose behalf. Version 3 is the native three-way update contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lockfileVersion", "items", "theme", "styles"],
  "properties": {
    "$schema": { "type": "string" },
    "lockfileVersion": { "const": 3 },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/item" }
    },
    "theme": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/theme" }]
    },
    "styles": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/styles" }]
    }
  },
  "definitions": {
    "receiptPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)[^/\\\\][^\\\\]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "wireType", "installedSha256", "baseSha256"],
      "properties": {
        "destination": { "$ref": "#/definitions/receiptPath" },
        "wireType": { "type": "string", "minLength": 1 },
        "installedSha256": { "$ref": "#/definitions/sha256" },
        "baseSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "registry", "sourceUrl", "wireType", "direct", "files"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "registry": { "type": ["string", "null"] },
        "sourceUrl": { "type": "string", "minLength": 1 },
        "wireType": { "type": "string", "minLength": 1 },
        "direct": { "type": "boolean" },
        "files": {
          "type": "array",
          "items": { "$ref": "#/definitions/file" }
        }
      }
    },
    "themeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "kind", "path"],
      "properties": {
        "itemId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["absorbed-file", "meta-fragment"] },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "sha256", "sources"],
      "properties": {
        "destination": { "$ref": "#/definitions/receiptPath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/definitions/themeSource" }
        }
      }
    },
    "styleSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "dependsOn", "imports"],
      "properties": {
        "itemId": { "type": "string", "minLength": 1 },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "imports": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "styles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "sha256", "sources"],
      "properties": {
        "destination": { "$ref": "#/definitions/receiptPath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/definitions/styleSource" }
        }
      }
    }
  }
}
