{
  "name": "manteen-kit",
  "version": "0.3.3",
  "description": "Author Mantine component registries in Mantine's vocabulary and compile them to an interchange format any registry client can read.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "manteen-kit": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./schema": "./schema/manteen.registry.schema.json",
    "./schema/author-profile": "./schema/manteen.author-profile.schema.json",
    "./schema/command": "./schema/manteen-kit-command.schema.json",
    "./schema/dev-event": "./schema/manteen-kit-dev-event.schema.json",
    "./schema/output": "./schema/manteen-kit-output.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "mantine",
    "registry",
    "components",
    "codemod"
  ],
  "scripts": {
    "build": "tsdown --config-loader native",
    "test": "bun test",
    "test:node": "node --test e2e/*.node-e2e.mjs",
    "verify:scaffold-consumers": "node scripts/verify-scaffold-consumers.mjs",
    "//prepare": "Runs on both install and publish, so a fresh clone has dist/ and the package-name import resolves without a manual build. It does NOT fix the bin symlink on that first install — bun links bins before running prepare, and skips any whose target is missing — but local work goes through the root scripts, which run the TS sources directly.",
    "prepare": "tsdown --config-loader native"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "semver": "7.8.5",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "tsdown": "^0.22.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arimxyer/manteen.git",
    "directory": "packages/registry-kit"
  },
  "homepage": "https://github.com/arimxyer/manteen/tree/main/packages/registry-kit#readme",
  "bugs": {
    "url": "https://github.com/arimxyer/manteen/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
