{
  "name": "mantine-registry-kit",
  "version": "0.1.0",
  "description": "Author Mantine component registries in Mantine's vocabulary and compile them to an interchange format any registry client can read.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mantine-registry": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./schema": "./schema/mantine-registry.schema.json"
  },
  "files": ["dist", "schema", "README.md"],
  "engines": {
    "node": ">=20.11"
  },
  "keywords": ["mantine", "registry", "components", "codemod"],
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "prepublishOnly": "tsdown"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.14"
  }
}
