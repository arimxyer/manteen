{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arimxyer.github.io/manteen/schema/manteen-kit-command.schema.json",
  "title": "manteen-kit command envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "command",
    "ok",
    "exitCode",
    "mutated",
    "payload",
    "errors",
    "notes",
    "actions"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "command": { "type": "string", "minLength": 1 },
    "ok": { "type": "boolean" },
    "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
    "mutated": { "type": "boolean" },
    "payload": {},
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "message": { "type": "string", "minLength": 1 },
          "details": {}
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "actions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "argv"],
        "properties": {
          "kind": { "const": "rerun" },
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["ok"],
        "properties": { "ok": { "const": true } }
      },
      "then": { "properties": { "exitCode": { "type": "integer", "const": 0 } } },
      "else": { "properties": { "exitCode": { "type": "integer", "minimum": 1 } } }
    }
  ]
}
