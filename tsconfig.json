{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    // These map the *consumer's* alias shape onto this repo's layout, so the
    // source files can be written with the import paths they will have AFTER
    // `shadcn add` places them — and still typecheck here.
    "paths": {
      "@/components/ui/*": ["./registry/ui/*"],
      "@/hooks/*": ["./registry/blocks/data-table/*"],
      "@/lib/*": ["./registry/lib/*"],
      // Mantine UI usage examples use the same `@/*` import init configures for
      // consumers. Explicit per-module entries are required because each item
      // nests in its own directory here but installs flat under components/ui.
      "@/components/ui/article-card": ["./registry/mantine-ui/article-card/article-card"],
      "@/components/ui/authentication-form": [
        "./registry/mantine-ui/authentication-form/authentication-form"
      ],
      "@/components/ui/autocomplete-loading": [
        "./registry/mantine-ui/autocomplete-loading/autocomplete-loading"
      ],
      "@/components/ui/button-progress": ["./registry/mantine-ui/button-progress/button-progress"],
      "@/components/ui/cards-carousel": ["./registry/mantine-ui/cards-carousel/cards-carousel"],
      "@/components/ui/dnd-list": ["./registry/mantine-ui/dnd-list/dnd-list"],
      "@/components/ui/dropzone-button": ["./registry/mantine-ui/dropzone-button/dropzone-button"],
      "@/components/ui/faq-simple": ["./registry/mantine-ui/faq-simple/faq-simple"],
      "@/components/ui/floating-label-input": [
        "./registry/mantine-ui/floating-label-input/floating-label-input"
      ],
      "@/components/ui/footer-links": ["./registry/mantine-ui/footer-links/footer-links"],
      "@/components/ui/header-mega-menu": [
        "./registry/mantine-ui/header-mega-menu/header-mega-menu"
      ],
      "@/components/ui/hero-image-right": [
        "./registry/mantine-ui/hero-image-right/hero-image-right"
      ],
      "@/components/ui/navbar-nested": ["./registry/mantine-ui/navbar-nested/navbar-nested"],
      "@/components/ui/password-strength": [
        "./registry/mantine-ui/password-strength/password-strength"
      ],
      "@/components/ui/stats-grid": ["./registry/mantine-ui/stats-grid/stats-grid"],
      "@/components/ui/table-sort": ["./registry/mantine-ui/table-sort/table-sort"],
      // The data-table block installs its component under the classic alias, but its
      // source lives under blocks/ — the wildcard above only covers registry/ui/.
      "@/components/ui/data-table": ["./registry/blocks/data-table/data-table"]
    }
  },
  "include": ["registry/**/*", "test/**/*", "packages/*/src/**/*", "packages/*/test/**/*"]
}
