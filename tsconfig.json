{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    // These map the *consumer's* alias shape onto this repo's layout, so the
    // source files can be written with the import paths they will have AFTER
    // `shadcn add` places them — and still typecheck here.
    "paths": {
      "@/components/ui/*": ["./registry/ui/*"],
      "@/hooks/*": ["./registry/blocks/data-table/*"],
      "@/lib/*": ["./registry/lib/*"],
      // Usage examples (`usage` in the catalog) are written with the consumer's
      // manteen alias. Explicit per-module entries, not `@ui/*`: each item nests
      // in its own directory here but installs flat under the alias.
      "@ui/article-card": ["./registry/mantine-ui/article-card/article-card"]
    }
  },
  "include": ["registry/**/*", "test/**/*", "packages/*/src/**/*", "packages/*/test/**/*"]
}
